          <div class="brand-icon">AV</div>
          <div>
            <div class="brand-name">AnimeVerse</div>
            <div class="brand-subtitle">Analytics</div>
          </div>
        </div>
        """,
        unsafe_allow_html=True,
    )


def page_header(title: str, subtitle: str, eyebrow: str = "Inteligensi Industri Anime"):
    st.markdown(f'<div class="eyebrow">{eyebrow}</div>', unsafe_allow_html=True)
    st.title(title)
