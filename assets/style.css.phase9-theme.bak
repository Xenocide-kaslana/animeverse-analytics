@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

:root {
  --lavender: #C5ADED;
  --pink: #F8ABEB;
  --soft-pink: #FFC8DD;
  --baby-blue: #BCE0FF;
  --sky-blue: #A2D2FF;
  --bg-light: #FAF8FF;
  --card-light: #FFFFFF;
  --sidebar-light: #F0EAFB;
  --text-light: #21164D;
  --muted-light: #77718C;
  --border-light: #E8E0F4;
  --bg-dark: #171426;
  --sidebar-dark: #120F20;
  --card-dark: #242039;
  --text-dark: #F8F5FF;
  --muted-dark: #B7AECF;
  --border-dark: #39314E;
}

html, body, [class*="css"] { font-family: "Inter", sans-serif; }
.stApp { background: var(--bg-light) !important; color: var(--text-light); }
[data-testid="stSidebarNav"] { display: none; }
[data-testid="stSidebar"] {
  background: var(--sidebar-light);
  border-right: 1px solid var(--border-light);
}
[data-testid="stSidebar"] * { color: var(--text-light); }
[data-testid="stSidebar"] [data-testid="stRadio"] label {
  border-radius: 12px;
  margin-bottom: 4px;
  padding: 7px 9px;
}
[data-testid="stSidebar"] [data-testid="stRadio"] label:has(input:checked) {
  background: var(--lavender);
  color: var(--text-light) !important;
}

.brand-mark { display: flex; align-items: center; gap: 12px; padding: 10px 2px 18px; }
.brand-icon {
  width: 43px; height: 43px; display: grid; place-items: center;
  border-radius: 14px; background: var(--lavender); color: var(--text-light) !important; font-weight: 800;
}
.brand-name { font-size: 1.05rem; font-weight: 800; }
.brand-subtitle { color: var(--muted-light) !important; font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; }
.sidebar-student-card {
  margin-top: 18px; padding: 12px; border-radius: 12px;
  background: rgba(197, 173, 237, .28); border: 1px solid rgba(197, 173, 237, .45);
}
.sidebar-student-name { font-size: .76rem; font-weight: 800; letter-spacing: .04em; }
.sidebar-student-id { font-size: .72rem; margin-top: 3px; color: var(--muted-light) !important; }
.nav-label, .filter-heading { color: var(--muted-light) !important; font-size: .68rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; margin: 10px 0 7px; }

.dashboard-identity {
  display: flex; align-items: center; justify-content: space-between; gap: 24px;
  padding: 6px 0 18px; margin-bottom: 6px;
  border-bottom: 1px solid var(--border-light);
}
.dashboard-brand { font-size: clamp(1.35rem, 2vw, 2rem); line-height: 1.05; letter-spacing: -.03em; font-weight: 800; color: var(--text-light); }
.dashboard-subtitle { font-size: .82rem; color: var(--muted-light); margin-top: 5px; }
.dashboard-student { text-align: right; display: grid; gap: 1px; color: var(--text-light); }
.dashboard-student strong { font-size: .82rem; letter-spacing: .03em; }
.dashboard-student span { font-size: .76rem; color: var(--muted-light); }
.dashboard-student small { font-size: .68rem; color: var(--muted-light); }

div[data-testid="stRadio"]:has(input[value="Ringkasan"]) { width: 100%; }
[data-testid="stRadio"][key*="dashboard_top_navigation"] { width: 100%; }
.st-key-dashboard_top_navigation { margin: 10px 0 18px; }
.st-key-dashboard_top_navigation [data-testid="stRadio"] label {
  border-radius: 999px; padding: 7px 12px; border: 1px solid transparent; margin-right: 5px;
}
.st-key-dashboard_top_navigation [data-testid="stRadio"] label:has(input:checked) {
  background: var(--lavender); border-color: var(--lavender); color: var(--text-light) !important;
}

.page-header { padding: 6px 0 18px; border-bottom: 1px solid var(--border-light); margin-bottom: 20px; }
.eyebrow { color: #8066B5; font-size: .72rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
.page-header h1 { color: var(--text-light); font-size: clamp(1.5rem, 2.5vw, 2.15rem); letter-spacing: -.035em; }
.page-header p, .page-header caption { color: var(--muted-light); }
.section-header { margin: 18px 0 12px; }
.section-header h2 { color: var(--text-light); font-size: 1.08rem; }
.section-header p { color: var(--muted-light); font-size: .82rem; }

.kpi-card, .chart-card, .insight-card, .empty-state {
  background: var(--card-light); border: 1px solid var(--border-light);
  border-radius: 16px; box-shadow: 0 8px 24px rgba(33, 22, 77, .055);
}
.kpi-card { min-height: 132px; padding: 18px; position: relative; overflow: hidden; }
.kpi-card::after { content: ""; position: absolute; width: 72px; height: 72px; right: -24px; top: -28px; border-radius: 50%; opacity: .28; }
.kpi-lavender { background: #F3EFFF; border-color: #DDD1F5; }
.kpi-lavender::after { background: var(--lavender); }
.kpi-pink { background: #FFF0FB; border-color: #F4C9EC; }
.kpi-pink::after { background: var(--pink); }
.kpi-blue { background: #EFF8FF; border-color: #CEE5FA; }
.kpi-blue::after { background: var(--baby-blue); }
.kpi-sky { background: #EFF6FF; border-color: #CDE0FA; }
.kpi-sky::after { background: var(--sky-blue); }
.kpi-label { color: var(--muted-light); font-size: .78rem; font-weight: 700; }
.kpi-value { color: var(--text-light); font-size: 1.72rem; font-weight: 800; letter-spacing: -.035em; margin-top: 8px; }
.kpi-detail { color: var(--muted-light); font-size: .74rem; margin-top: 7px; }

.chart-card { padding: 16px 16px 2px; margin-bottom: 10px; overflow: hidden; }
.chart-title { color: var(--text-light); font-weight: 800; }
.chart-subtitle { color: var(--muted-light); font-size: .76rem; margin-top: 4px; }
.insight-card { border-left: 4px solid var(--lavender); padding: 15px; margin-bottom: 12px; }
.insight-success { border-left-color: var(--baby-blue); }
.insight-warning { border-left-color: var(--pink); }
.insight-title { color: var(--text-light); font-size: .82rem; font-weight: 800; }
.insight-text { color: var(--muted-light); font-size: .82rem; line-height: 1.55; margin-top: 5px; }
.empty-state { color: var(--muted-light); padding: 38px 20px; text-align: center; }
.empty-title { color: var(--text-light); font-weight: 800; margin-bottom: 6px; }
.loading-state { color: var(--muted-light); display: flex; align-items: center; gap: 8px; }
.loading-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--lavender); }
.app-footer { border-top: 1px solid var(--border-light); color: var(--muted-light); font-size: .72rem; margin-top: 32px; padding: 18px 0 6px; text-align: center; }

.dark-theme.stApp, .dark-theme .stApp, [data-testid="stApp"].dark-theme {
  background: var(--bg-dark) !important; color: var(--text-dark);
}
[data-testid="stApp"].dark-theme [data-testid="stSidebar"] { background: var(--sidebar-dark); border-color: var(--border-dark); }
[data-testid="stApp"].dark-theme [data-testid="stSidebar"] * { color: var(--text-dark); }
.dark-theme .dashboard-identity, .dark-theme .page-header, .dark-theme .app-footer { border-color: var(--border-dark); }
.dark-theme .dashboard-brand, .dark-theme .dashboard-student strong, .dark-theme .page-header h1, .dark-theme .section-header h2,
.dark-theme .kpi-value, .dark-theme .chart-title, .dark-theme .insight-title, .dark-theme .empty-title { color: var(--text-dark); }
.dark-theme .dashboard-subtitle, .dark-theme .dashboard-student span, .dark-theme .dashboard-student small,
.dark-theme .page-header p, .dark-theme .section-header p, .dark-theme .kpi-detail, .dark-theme .chart-subtitle,
.dark-theme .insight-text, .dark-theme .app-footer, .dark-theme .sidebar-student-id { color: var(--muted-dark) !important; }
.dark-theme .kpi-card, .dark-theme .chart-card, .dark-theme .insight-card, .dark-theme .empty-state {
  background: var(--card-dark); border-color: var(--border-dark); box-shadow: none;
}
.dark-theme .kpi-card { color: var(--text-dark); }

@media (max-width: 768px) {
  [data-testid="stSidebar"] { min-width: 18rem !important; }
  .dashboard-identity { align-items: flex-start; flex-direction: column; gap: 10px; }
  .dashboard-student { text-align: left; }
  .kpi-card { min-height: 112px; }
  .st-key-dashboard_top_navigation [data-testid="stRadio"] label { margin-bottom: 5px; font-size: .78rem; }
  .page-header { padding-top: 4px; }
}
